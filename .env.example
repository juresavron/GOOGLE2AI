# ---- server --------------------------------------------------------------
# Long random string; the MCP endpoint lives at https://<domain>/<MCP_SECRET>/mcp (treat the URL like
# a password). Generate one:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MCP_SECRET=change-me
PORT=8000
LOG_LEVEL=info
GSC_TZ=Europe/Ljubljana     # timezone named in the instructions Claude reads

# ---- Google --------------------------------------------------------------
# FOUR ways to authenticate, tried in this order. On a hosted box only the first one works: there is
# no gcloud on a container, and Search Console's "Add user" form rejects freshly created service
# accounts ("email not found"), so a service account can only read properties it was already granted.
#
# 1. OAuth — the supported path. Calls run as the person who consented, so every property that
#    account owns is readable with nothing to configure in Search Console. See DEPLOY.md for how to
#    mint the refresh token; it is a one-off on your own machine.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# REQUIRED with OAuth: user credentials must name a project to bill, or Search Console answers
# 403 PERMISSION_DENIED with a message that reads like a permissions problem.
GOOGLE_QUOTA_PROJECT=

# 2. A service account key as a STRING, for `fly secrets set` where there is no file to mount.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
#
# 3. A service account key file, for a VPS or a local run. Store it OUTSIDE this repo.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json
#
# 4. Nothing set: gcloud Application Default Credentials. Local development only.

# Optional: bind this connector to one property, so tools can be called without siteUrl. Spell it
# exactly as Search Console does — "sc-domain:example.com" or "https://example.com/".
# GSC_DEFAULT_SITE=sc-domain:example.com

# Ceiling for one search_analytics call. Google's own maximum is 25000 and larger values are refused.
# GSC_MAX_ROWS=25000

# Serve seeded demo data instead of calling Google. What the test suite and CI run on.
# GSC_MOCK=1

# ---- docker compose (self-hosted only) -----------------------------------
DOMAIN=gsc.example.com
ACME_EMAIL=you@example.com

# ---- multi-account build -------------------------------------------------
# Set all three of SUPABASE_URL, SUPABASE_ANON_KEY and DATABASE_URL to mount the tenant surface:
# a landing page, sign-in, a dashboard, and revocable per-tenant connector URLs at /c/<token>/mcp.
# Leave any of them unset and this stays the single-account server, with no login and no database.
#
# Apply db/schema.sql to a Supabase project of ITS OWN first. The preflight block at the top of it
# refuses to run on imap2ai's or whatsapp2ai's database, because mcp_tokens and mcp_calls exist in
# all three and the collision is silent rather than loud.
#
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_...
#
# DATABASE_URL: use the SESSION POOLER string (Project Settings -> Database -> Session pooler), not
# the direct db.<ref>.supabase.co host. The direct host publishes only an AAAA record and Fly has no
# public IPv6 egress, so it is unreachable there and fails as ENETUNREACH, which names nothing.
# The pooler username carries the project ref: postgres.<ref>
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Seals every tenant's Google refresh token (src/secrets.ts). The tenant build REFUSES TO START
# without it rather than storing credentials in the clear. Losing it is recoverable -- tenants
# reconnect -- but disruptive. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# MASTER_KEY=
#
# The origin this server is reached at, used to build the Google redirect URI. Taken from config
# rather than from the request, because a Host header is attacker-controlled and deriving the
# redirect from one would let a forged request send the consent somewhere else. It must match a
# redirect URI registered on the OAuth client EXACTLY:  <PUBLIC_ORIGIN>/oauth/google/callback
# PUBLIC_ORIGIN=https://google2ai.fly.dev
#
# How many properties one user may connect. Not a plan -- a ceiling: every one is a live Google
# grant this server is responsible for.
# MAX_ACCOUNTS_PER_USER=5
#
# Tool calls a minute, per ACCOUNT. The threat is an agent loop, not a stolen URL.
# MAX_CALLS_PER_MINUTE=120

# ---- operator ------------------------------------------------------------
# Read only by the legal pages. Left unset, /privacy and /terms say so rather than naming a company
# that does not exist.
# OPERATOR_NAME=Example d.o.o.
# OPERATOR_CONTACT=hello@example.com
# OPERATOR_LAW=Slovenia
#
# Comma-separated addresses allowed to open the operator panel. Checked server-side on every
# request; empty means nobody, which is the right default.
# ADMIN_EMAILS=you@example.com
#
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# DATABASE_URL=
